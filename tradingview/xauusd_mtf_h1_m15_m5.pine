//@version=6
// =====================================================================
//  XAUUSD MTF Signal  —  H1 (trend) + M15 (confirm) + M5 (entry)
//  Pasang pada chart XAUUSD timeframe 5 minit (M5).
//  SL berdasarkan swing, MAKSIMUM 50 pips (1 pip XAUUSD = 0.10 secara default).
//  Ini "strategy" supaya anda boleh lihat winrate sebenar dalam Strategy Tester.
// =====================================================================
strategy("XAUUSD MTF H1/M15/M5 Signal", shorttitle = "XAU MTF", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1,
     pyramiding = 0, slippage = 2, commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.0, process_orders_on_close = false)

// ---------------- INPUTS ----------------
grpTF   = "Timeframe"
htf     = input.timeframe("60", "Trend TF (H1)",   group = grpTF)
mtf     = input.timeframe("15", "Confirm TF (M15)", group = grpTF)

grpH1   = "H1 Trend"
h1Fast  = input.int(50,  "H1 EMA Fast", minval = 1, group = grpH1)
h1Slow  = input.int(200, "H1 EMA Slow", minval = 1, group = grpH1)

grpM15  = "M15 Confirm"
m15Fast = input.int(21, "M15 EMA Fast", minval = 1, group = grpM15)
m15Slow = input.int(50, "M15 EMA Slow", minval = 1, group = grpM15)
m15RsiL = input.int(14, "M15 RSI Length", minval = 1, group = grpM15)

grpM5   = "M5 Entry"
m5Fast  = input.int(9,  "M5 EMA Fast", minval = 1, group = grpM5)
m5Slow  = input.int(21, "M5 EMA Slow (pullback zone)", minval = 1, group = grpM5)
pbBars  = input.int(4,  "Pullback lookback (bars)", minval = 1, group = grpM5)
rsiLen  = input.int(14, "M5 RSI Length", minval = 1, group = grpM5)
rsiMaxB = input.int(70, "BUY: RSI max (elak beli di puncak)", group = grpM5)
rsiMinS = input.int(30, "SELL: RSI min (elak jual di dasar)", group = grpM5)
useAdx  = input.bool(true, "Guna ADX filter (elak pasaran sideways)", group = grpM5)
adxLen  = input.int(14, "ADX Length", minval = 1, group = grpM5)
adxMin  = input.float(20, "ADX minimum", group = grpM5)

grpRisk  = "Risk / SL / TP"
pipSize  = input.float(0.10, "Saiz 1 pip (XAUUSD biasanya 0.10)", step = 0.01, group = grpRisk)
maxSLp   = input.float(50, "SL maksimum (pips)", minval = 1, maxval = 50, group = grpRisk)
minSLp   = input.float(15, "SL minimum (pips)", minval = 1, group = grpRisk)
swingLB  = input.int(10, "Swing lookback untuk SL (bars)", minval = 2, group = grpRisk)
bufPips  = input.float(5, "Buffer bawah/atas swing (pips)", minval = 0, group = grpRisk)
slMode   = input.string("Skip trade", "Jika swing SL > maksimum", options = ["Skip trade", "Cap pada maksimum"], group = grpRisk)
rr       = input.float(1.0, "TP = SL x (Risk:Reward)", minval = 0.1, step = 0.1, group = grpRisk)
useBE    = input.bool(true, "Breakeven", group = grpRisk)
beTrig   = input.float(0.6, "Pindah SL ke BE bila untung capai (x SL)", minval = 0.1, step = 0.1, group = grpRisk)
beLock   = input.float(2, "Kunci untung semasa BE (pips)", minval = 0, group = grpRisk)

grpFlt   = "Filter Masa"
useSess  = input.bool(true, "Trade dalam sesi sahaja", group = grpFlt)
sess     = input.session("0700-2000", "Sesi London + New York (UTC)", group = grpFlt)

grpVis   = "Paparan"
showEma  = input.bool(true, "Tunjuk EMA M5", group = grpVis)
showDash = input.bool(true, "Tunjuk dashboard", group = grpVis)

// ---------------- HIGHER TIMEFRAME DATA (tanpa repaint) ----------------
[h1C, h1F, h1S] = request.security(syminfo.tickerid, htf,
     [close[1], ta.ema(close, h1Fast)[1], ta.ema(close, h1Slow)[1]], lookahead = barmerge.lookahead_on)

[m15C, m15F, m15S, m15R] = request.security(syminfo.tickerid, mtf,
     [close[1], ta.ema(close, m15Fast)[1], ta.ema(close, m15Slow)[1], ta.rsi(close, m15RsiL)[1]], lookahead = barmerge.lookahead_on)

h1Bull  = h1C > h1F and h1F > h1S
h1Bear  = h1C < h1F and h1F < h1S
m15Bull = m15C > m15F and m15F > m15S and m15R > 50
m15Bear = m15C < m15F and m15F < m15S and m15R < 50

// ---------------- M5 ENTRY ----------------
e5F  = ta.ema(close, m5Fast)
e5S  = ta.ema(close, m5Slow)
rsi5 = ta.rsi(close, rsiLen)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)

adxOk  = not useAdx or adx >= adxMin
sessOk = not useSess or not na(time(timeframe.period, sess, "UTC"))

// BUY: harga pullback sentuh EMA21 M5, kemudian candle bullish tutup atas EMA9 & atas high candle sebelum
pbBuy  = ta.lowest(low, pbBars) <= e5S and close > e5F and e5F > e5S and close > open and close > high[1] and rsi5 > 50 and rsi5 < rsiMaxB
// SELL: harga pullback sentuh EMA21 M5, kemudian candle bearish tutup bawah EMA9 & bawah low candle sebelum
pbSell = ta.highest(high, pbBars) >= e5S and close < e5F and e5F < e5S and close < open and close < low[1] and rsi5 < 50 and rsi5 > rsiMinS

// ---------------- SL / TP ----------------
maxSL = maxSLp * pipSize
minSL = minSLp * pipSize
buf   = bufPips * pipSize

rawSLBuy  = close - (ta.lowest(low, swingLB) - buf)
rawSLSell = (ta.highest(high, swingLB) + buf) - close

f_sl(raw) =>
    d = math.max(raw, minSL)
    d > maxSL ? (slMode == "Skip trade" ? na : maxSL) : d

slBuy  = f_sl(rawSLBuy)
slSell = f_sl(rawSLSell)

flat = strategy.position_size == 0

buySignal  = flat and sessOk and adxOk and h1Bull and m15Bull and pbBuy  and not na(slBuy)  and barstate.isconfirmed
sellSignal = flat and sessOk and adxOk and h1Bear and m15Bear and pbSell and not na(slSell) and barstate.isconfirmed

// ---------------- ORDER MANAGEMENT ----------------
var float slPrice  = na
var float tpPrice  = na
var float riskDist = na
var bool  beDone   = false

if buySignal
    riskDist := slBuy
    slPrice  := close - slBuy
    tpPrice  := close + slBuy * rr
    beDone   := false
    strategy.entry("BUY", strategy.long)
    strategy.exit("XB", "BUY", stop = slPrice, limit = tpPrice, comment_loss = "SL", comment_profit = "TP")
    alert("XAUUSD BUY @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slPrice, format.mintick) + " (" + str.tostring(slBuy / pipSize, "#.#") + " pips) | TP " + str.tostring(tpPrice, format.mintick), alert.freq_once_per_bar_close)

if sellSignal
    riskDist := slSell
    slPrice  := close + slSell
    tpPrice  := close - slSell * rr
    beDone   := false
    strategy.entry("SELL", strategy.short)
    strategy.exit("XS", "SELL", stop = slPrice, limit = tpPrice, comment_loss = "SL", comment_profit = "TP")
    alert("XAUUSD SELL @ " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slPrice, format.mintick) + " (" + str.tostring(slSell / pipSize, "#.#") + " pips) | TP " + str.tostring(tpPrice, format.mintick), alert.freq_once_per_bar_close)

// Breakeven
if strategy.position_size > 0
    ep = strategy.position_avg_price
    if useBE and not beDone and high >= ep + riskDist * beTrig
        slPrice := ep + beLock * pipSize
        beDone  := true
    strategy.exit("XB", "BUY", stop = slPrice, limit = tpPrice, comment_loss = beDone ? "BE" : "SL", comment_profit = "TP")

if strategy.position_size < 0
    ep = strategy.position_avg_price
    if useBE and not beDone and low <= ep - riskDist * beTrig
        slPrice := ep - beLock * pipSize
        beDone  := true
    strategy.exit("XS", "SELL", stop = slPrice, limit = tpPrice, comment_loss = beDone ? "BE" : "SL", comment_profit = "TP")

inTrade = strategy.position_size != 0 or buySignal or sellSignal

// ---------------- PLOTS ----------------
plot(showEma ? e5F : na, "M5 EMA Fast", color = color.new(color.aqua, 0))
plot(showEma ? e5S : na, "M5 EMA Slow", color = color.new(color.orange, 0))
plot(inTrade ? slPrice : na, "SL", color = color.red,   style = plot.style_linebr, linewidth = 2)
plot(inTrade ? tpPrice : na, "TP", color = color.green, style = plot.style_linebr, linewidth = 2)

plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color.new(color.green, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color.new(color.red, 0),   text = "SELL", textcolor = color.white, size = size.small)

bgcolor(h1Bull and m15Bull ? color.new(color.green, 93) : h1Bear and m15Bear ? color.new(color.red, 93) : na, title = "Bias H1+M15")

// ---------------- DASHBOARD ----------------
var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

f_bias(bull, bear) => bull ? "BULL" : bear ? "BEAR" : "NEUTRAL"
f_col(bull, bear) => bull ? color.green : bear ? color.red : color.gray

if showDash and barstate.islast
    closed = strategy.closedtrades
    wr = closed > 0 ? 100.0 * strategy.wintrades / closed : 0.0
    table.cell(dash, 0, 0, "XAU MTF", text_color = color.white)
    table.cell(dash, 1, 0, timeframe.period == "5" ? "Chart M5 OK" : "Tukar chart ke M5!", text_color = timeframe.period == "5" ? color.lime : color.yellow)
    table.cell(dash, 0, 1, "H1",  text_color = color.white)
    table.cell(dash, 1, 1, f_bias(h1Bull, h1Bear),   text_color = color.white, bgcolor = f_col(h1Bull, h1Bear))
    table.cell(dash, 0, 2, "M15", text_color = color.white)
    table.cell(dash, 1, 2, f_bias(m15Bull, m15Bear), text_color = color.white, bgcolor = f_col(m15Bull, m15Bear))
    table.cell(dash, 0, 3, "M5",  text_color = color.white)
    table.cell(dash, 1, 3, f_bias(e5F > e5S and close > e5F, e5F < e5S and close < e5F), text_color = color.white, bgcolor = f_col(e5F > e5S and close > e5F, e5F < e5S and close < e5F))
    table.cell(dash, 0, 4, "ADX", text_color = color.white)
    table.cell(dash, 1, 4, str.tostring(adx, "#.0"), text_color = adxOk ? color.lime : color.gray)
    table.cell(dash, 0, 5, "Trades", text_color = color.white)
    table.cell(dash, 1, 5, str.tostring(closed), text_color = color.white)
    table.cell(dash, 0, 6, "Winrate", text_color = color.white)
    table.cell(dash, 1, 6, str.tostring(wr, "#.0") + "%", text_color = wr >= 80 ? color.lime : wr >= 60 ? color.yellow : color.orange)
    table.cell(dash, 0, 7, "Net P/L", text_color = color.white)
    table.cell(dash, 1, 7, str.tostring(strategy.netprofit, "#.##"), text_color = strategy.netprofit >= 0 ? color.lime : color.red)
