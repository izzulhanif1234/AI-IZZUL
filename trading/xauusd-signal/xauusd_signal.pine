//@version=6
// ============================================================================
//  XAUUSD Signal - dua mode
//
//  1) Win Rate Tinggi (default) - chart H1 sahaja
//     BUY bila harga jatuh mendadak (RSI 2 < 30) tetapi trend masih kukuh:
//     H4 atas EMA200, H1 atas EMA50 dan EMA200. COLLECT 0.5 ATR,
//     SL 2.5 ATR, SL dipindah ke entry bila untung 0.3 ATR, tutup trade
//     selepas 12 candle kalau COLLECT/SL belum kena. SELL tutup secara
//     default (tiada edge dalam backtest).
//
//  2) Trend (TP3) - chart M15 (trend H1)
//     Pullback ke EMA21 dalam trend, sasar TP 1R / 2R / 3R.
//
//  Signal hanya keluar bila candle TUTUP -> tiada repaint.
// ============================================================================
indicator("XAUUSD Signal", shorttitle = "XAU Signal", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ----- Mode -----
MODE_HW = "Win Rate Tinggi (H1)"
MODE_TR = "Trend TP3 (M15)"
mode = input.string(MODE_HW, "Mode", options = [MODE_HW, MODE_TR])
isHw = mode == MODE_HW

// ----- Input: Win Rate Tinggi -----
gH = "Mode Win Rate Tinggi"
hwHtf = input.timeframe("240", "Timeframe trend (EMA200)", group = gH)
hwLvl = input.int(30, "RSI(2): BUY bawah, SELL atas (100 - nilai)", minval = 1, maxval = 49, group = gH)
hwAdx = input.float(30, "ADX maksimum", group = gH)
hwSL  = input.float(2.5, "SL (x ATR)", step = 0.1, group = gH)
hwTP  = input.float(0.5, "TP (x ATR)", step = 0.1, group = gH)
hwBE  = input.float(0.3, "Pindah SL ke entry bila untung (x ATR), 0 = tutup", step = 0.1, group = gH)
hwMax = input.int(12, "Time stop: tutup selepas N candle", minval = 1, group = gH)
hwStr = input.bool(true, "Signal solid sahaja: harga H1 atas EMA50 & EMA200", group = gH)
hwSellOn = input.bool(false, "Benarkan SELL (lemah dalam backtest)", group = gH)

// ----- Input: Trend -----
gT = "Mode Trend"
htf     = input.timeframe("60", "Timeframe trend (EMA HTF)", group = gT)
htfLen  = input.int(200, "EMA trend HTF", minval = 1, group = gT)
fastLen = input.int(21, "EMA pantas", minval = 1, group = gT)
slowLen = input.int(50, "EMA perlahan", minval = 1, group = gT)
pbLen   = input.int(5, "Lookback pullback (bar)", minval = 1, group = gT)
useAdx  = input.bool(true, "Penapis ADX, minimum", inline = "adx", group = gT)
adxMin  = input.float(20, "", inline = "adx", group = gT)
slBuf   = input.float(0.2, "Buffer SL (x ATR)", step = 0.1, group = gT)
minRisk = input.float(0.8, "SL minimum (x ATR)", step = 0.1, group = gT)
maxRisk = input.float(2.5, "SL maksimum (x ATR), lebih jauh = skip", step = 0.1, group = gT)
tp1R    = input.float(1.0, "TP1 (R)", step = 0.5, group = gT)
tp2R    = input.float(2.0, "TP2 (R)", step = 0.5, group = gT)
tp3R    = input.float(3.0, "TP3 (R)", step = 0.5, group = gT)

// ----- Input: Umum -----
gC = "Umum"
useSess = input.bool(true, "Sesi London + New York sahaja", group = gC)
sess    = input.session("1400-0200", "Sesi (waktu Malaysia)", group = gC)
spread  = input.float(0.30, "Anggaran spread + komisen ($) untuk statistik", step = 0.05, group = gC)

gD = "Paparan"
showEma  = input.bool(false, "Tunjuk EMA", group = gD)
showLvls = input.bool(true, "Tunjuk garisan ENTRY / COLLECT / SL (trade terkini sahaja)", group = gD)
showExit = input.bool(true, "Tunjuk titik keputusan trade lama", group = gD)
showPrep = input.bool(true, "Tunjuk BERSEDIA pada candle yang sedang bergerak", group = gD)
showTbl  = input.bool(true, "Tunjuk panel", group = gD)

if isHw and timeframe.in_seconds(hwHtf) < timeframe.in_seconds()
    runtime.error("Timeframe trend mesti sama atau lebih besar dari timeframe chart.")
if not isHw and timeframe.in_seconds(htf) < timeframe.in_seconds()
    runtime.error("Timeframe trend (HTF) mesti sama atau lebih besar dari timeframe chart.")

// ----- Indikator -----
emaF = ta.ema(close, fastLen)
emaS = ta.ema(close, slowLen)
rsi  = ta.rsi(close, 14)
rsi2 = ta.rsi(close, 2)
atr  = ta.atr(14)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)
[diP, diM, adx] = ta.dmi(14, 14)

// Nilai HTF dari bar yang SUDAH tutup (tiada repaint)
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead = barmerge.lookahead_on)
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_on)
hwClose  = request.security(syminfo.tickerid, hwHtf, close[1], lookahead = barmerge.lookahead_on)
hwEma    = request.security(syminfo.tickerid, hwHtf, ta.ema(close, 200)[1], lookahead = barmerge.lookahead_on)

inSess = not useSess or not na(time(timeframe.period, sess, "Asia/Kuala_Lumpur"))

// ----- Syarat mode Win Rate Tinggi -----
hwUp   = hwClose > hwEma
hwStrUp = close > e50 and close > e200
hwStrDn = close < e50 and close < e200
hwBuy  = hwUp and rsi2 < hwLvl and adx < hwAdx and inSess and (not hwStr or hwStrUp)
hwSell = hwSellOn and hwClose < hwEma and rsi2 > 100 - hwLvl and adx < hwAdx and inSess and (not hwStr or hwStrDn)

// ----- Syarat mode Trend -----
adxOk   = not useAdx or adx > adxMin
loN     = ta.lowest(low, pbLen)
hiN     = ta.highest(high, pbLen)
trendUp = htfClose > htfEma and emaF > emaS and close > emaS
trendDn = htfClose < htfEma and emaF < emaS and close < emaS
trBuy   = trendUp and loN <= emaF and close > open and close > high[1] and close > emaF and rsi > 50 and rsi < 70 and adxOk and inSess
trSell  = trendDn and hiN >= emaF and close < open and close < low[1] and close < emaF and rsi < 50 and rsi > 30 and adxOk and inSess
rawRiskBuy  = close - (loN - slBuf * atr)
rawRiskSell = (hiN + slBuf * atr) - close
riskBuy     = math.max(rawRiskBuy, minRisk * atr)
riskSell    = math.max(rawRiskSell, minRisk * atr)

// ----- Jejak trade (satu trade pada satu masa) -----
var int   tDir  = 0
var int   tBar  = na
var float tEnt  = na
var float tSL   = na
var float tTP1  = na
var float tTP2  = na
var float tTP3  = na
var float tAtr  = na
var bool  tBeOn = false
var bool  h1    = false
var bool  h2    = false
var bool  h3    = false

// statistik mode Trend
var int nDone = 0
var int w1    = 0
var int w2    = 0
var int w3    = 0
// statistik mode Win Rate Tinggi ($ per 1 oz, selepas spread)
var int   nTP   = 0
var int   nBE   = 0
var int   nSL   = 0
var int   nTM   = 0
var float gWin  = 0.0
var float gLoss = 0.0
var float sumTP = 0.0
var float sumSL = 0.0

closedNow = false
beNow     = false
exitTxt   = ""
exitNet   = 0.0
exitPx    = 0.0
exitDir   = 0

if tDir != 0 and bar_index > tBar
    slHit = tDir == 1 ? low <= tSL : high >= tSL
    if isHw
        tpHit = not slHit and (tDir == 1 ? high >= tTP1 : low <= tTP1)
        if slHit
            exitPx  := tSL
            exitTxt := tBeOn ? "BE" : "SL"
        else if tpHit
            exitPx  := tTP1
            exitTxt := "TP"
        else
            if hwBE > 0 and not tBeOn and (tDir == 1 ? high >= tEnt + hwBE * tAtr : low <= tEnt - hwBE * tAtr)
                tSL   := tEnt
                tBeOn := true
                beNow := true
            if bar_index - tBar >= hwMax
                exitPx  := close
                exitTxt := "TIME"
        if exitTxt != ""
            exitNet := (exitPx - tEnt) * tDir - spread
            nTP += exitTxt == "TP" ? 1 : 0
            nBE += exitTxt == "BE" ? 1 : 0
            nSL += exitTxt == "SL" ? 1 : 0
            nTM += exitTxt == "TIME" ? 1 : 0
            sumTP += exitTxt == "TP" ? exitNet : 0.0
            sumSL += exitTxt == "SL" ? exitNet : 0.0
            gWin  += exitNet > 0 ? exitNet : 0.0
            gLoss += exitNet < 0 ? -exitNet : 0.0
    else
        if not slHit      // SL & TP dalam candle sama -> dikira SL (konservatif)
            h1 := h1 or (tDir == 1 ? high >= tTP1 : low <= tTP1)
            h2 := h2 or (tDir == 1 ? high >= tTP2 : low <= tTP2)
            h3 := h3 or (tDir == 1 ? high >= tTP3 : low <= tTP3)
        if slHit or h3
            nDone += 1
            w1 += h1 ? 1 : 0
            w2 += h2 ? 1 : 0
            w3 += h3 ? 1 : 0
            exitTxt := h3 ? "TP3" : h2 ? "SL lepas TP2" : h1 ? "SL lepas TP1" : "SL"
            exitPx  := h3 ? tTP3 : tSL
            exitNet := (exitPx - tEnt) * tDir - spread
    if exitTxt != ""
        exitDir   := tDir
        tDir      := 0
        closedNow := true

// Lukisan trade terkini sahaja (yang lama dipadam bila signal baru keluar)
var array<line>  curLines  = array.new<line>()
var array<label> curLabels = array.new<label>()

f(x) => str.tostring(x, format.mintick)
lvl(x2, y, nm, col, sty) =>
    array.push(curLines, line.new(bar_index, y, x2, y, color = col, style = sty, width = 2))
    array.push(curLabels, label.new(x2, y, nm + "  " + f(y), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))

if closedNow
    alert("XAU " + (exitTxt == "TP" ? "COLLECT" : exitTxt) + ": trade selesai, " + (exitNet >= 0 ? "+" : "") + str.tostring(exitNet, "0.00") + " $/oz" + (exitTxt == "TIME" ? " - TUTUP TRADE SEKARANG pada " + f(close) : ""), alert.freq_once_per_bar_close)
if beNow
    alert("XAU: pindah SL ke entry " + f(tEnt) + " (breakeven)", alert.freq_once_per_bar_close)

// ----- Signal baru -----
okBuy  = isHw ? hwBuy : trBuy and rawRiskBuy <= maxRisk * atr
okSell = isHw ? hwSell : trSell and rawRiskSell <= maxRisk * atr
buySig  = barstate.isconfirmed and tDir == 0 and not closedNow and okBuy
sellSig = barstate.isconfirmed and tDir == 0 and not closedNow and okSell and not buySig

if buySig or sellSig
    tDir  := buySig ? 1 : -1
    tBar  := bar_index
    tEnt  := close
    tAtr  := atr
    tBeOn := false
    h1 := false
    h2 := false
    h3 := false
    for ln in curLines
        line.delete(ln)
    for lb in curLabels
        label.delete(lb)
    array.clear(curLines)
    array.clear(curLabels)
    side = buySig ? "BUY" : "SELL"
    txt  = ""
    msg  = '{"signal":"' + side + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","mode":"' + (isHw ? "winrate" : "trend") + '"'
    if isHw
        tSL  := close - tDir * hwSL * atr
        tTP1 := close + tDir * hwTP * atr
        tTP2 := na
        tTP3 := na
        beLvl = close + tDir * hwBE * atr
        txt := side + " SEKARANG\nENTRY    " + f(tEnt) + "\nCOLLECT  " + f(tTP1) + "\nSL       " + f(tSL)
        if hwBE > 0
            txt := txt + "\nSL ke entry bila harga " + f(beLvl)
        txt := txt + "\nTutup sendiri lepas " + str.tostring(hwMax) + " candle"
        msg := msg + ',"entry":' + f(tEnt) + ',"tp":' + f(tTP1) + ',"sl":' + f(tSL) + ',"be_trigger":' + f(beLvl) + ',"max_bars":' + str.tostring(hwMax) + '}'
        if showLvls
            lvl(bar_index + hwMax, tEnt, "ENTRY", color.blue, line.style_solid)
            lvl(bar_index + hwMax, tTP1, "COLLECT", color.green, line.style_solid)
            lvl(bar_index + hwMax, tSL, "SL", color.red, line.style_solid)
            if hwBE > 0
                lvl(bar_index + hwMax, beLvl, "SL KE ENTRY", color.gray, line.style_dotted)
    else
        risk = buySig ? riskBuy : riskSell
        tSL  := close - tDir * risk
        tTP1 := close + tDir * tp1R * risk
        tTP2 := close + tDir * tp2R * risk
        tTP3 := close + tDir * tp3R * risk
        txt := side + " SEKARANG\nENTRY      " + f(tEnt) + "\nCOLLECT 1  " + f(tTP1) + "\nCOLLECT 2  " + f(tTP2) + "\nCOLLECT 3  " + f(tTP3) + "\nSL         " + f(tSL)
        msg := msg + ',"entry":' + f(tEnt) + ',"sl":' + f(tSL) + ',"tp1":' + f(tTP1) + ',"tp2":' + f(tTP2) + ',"tp3":' + f(tTP3) + '}'
        if showLvls
            lvl(bar_index + 15, tEnt, "ENTRY", color.blue, line.style_solid)
            lvl(bar_index + 15, tTP1, "COLLECT 1", color.new(color.green, 40), line.style_dashed)
            lvl(bar_index + 15, tTP2, "COLLECT 2", color.new(color.green, 20), line.style_dashed)
            lvl(bar_index + 15, tTP3, "COLLECT 3", color.green, line.style_solid)
            lvl(bar_index + 15, tSL, "SL", color.red, line.style_solid)
    lblY   = buySig ? low - 0.3 * atr : high + 0.3 * atr
    lblSty = buySig ? label.style_label_up : label.style_label_down
    lblCol = buySig ? color.green : color.red
    array.push(curLabels, label.new(bar_index, lblY, txt, style = lblSty, color = lblCol, textcolor = color.white, size = size.small))
    alert(msg, alert.freq_once_per_bar_close)

// BERSEDIA: setup sedang terbentuk pada candle yang belum tutup (belum signal sah)
prepBuy  = showPrep and not barstate.isconfirmed and tDir == 0 and okBuy
prepSell = showPrep and not barstate.isconfirmed and tDir == 0 and okSell and not prepBuy
if prepBuy or prepSell
    alert("XAU BERSEDIA " + (prepBuy ? "BUY" : "SELL") + ": setup sedang terbentuk di " + f(close) + ", signal sah bila candle tutup", alert.freq_once_per_bar)

alertcondition(buySig, "XAU BUY", "XAUUSD BUY signal - semak chart untuk Entry/SL/TP")
alertcondition(sellSig, "XAU SELL", "XAUUSD SELL signal - semak chart untuk Entry/SL/TP")
alertcondition(beNow, "XAU pindah SL ke entry", "XAUUSD: pindah SL ke harga entry (breakeven)")
alertcondition(closedNow and exitTxt == "TIME", "XAU time stop", "XAUUSD: TUTUP TRADE SEKARANG (time stop)")
alertcondition(prepBuy or prepSell, "XAU bersedia", "XAUUSD: setup sedang terbentuk, bersedia - signal sah bila candle tutup")

// ----- Plot -----
plot(showEma and not isHw ? emaF : na, "EMA pantas", color = color.aqua)
plot(showEma and not isHw ? emaS : na, "EMA perlahan", color = color.orange)
plot(showEma ? (isHw ? hwEma : htfEma) : na, "EMA trend HTF", color = color.gray, linewidth = 2, style = plot.style_stepline)
plot(showEma and isHw ? e50 : na, "EMA50", color = color.orange)
plot(showEma and isHw ? e200 : na, "EMA200", color = color.purple)

// Signal lama: segi tiga kecil sahaja
plotshape(buySig, "BUY", style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small)
plotshape(sellSig, "SELL", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)
plotshape(prepBuy, "BERSEDIA BUY", style = shape.diamond, location = location.belowbar, color = color.yellow, text = "BERSEDIA", textcolor = color.yellow, size = size.tiny)
plotshape(prepSell, "BERSEDIA SELL", style = shape.diamond, location = location.abovebar, color = color.yellow, text = "BERSEDIA", textcolor = color.yellow, size = size.tiny)

// Keputusan trade lama: titik kecil di harga keluar
exShow = showExit and closedNow
plotshape(exShow and (exitTxt == "TP" or exitTxt == "TP3") ? exitPx : na, "Kena COLLECT", style = shape.circle, location = location.absolute, color = color.green, size = size.tiny)
plotshape(exShow and exitTxt == "BE" ? exitPx : na, "Keluar di entry (BE)", style = shape.circle, location = location.absolute, color = color.gray, size = size.tiny)
plotshape(exShow and str.startswith(exitTxt, "SL") ? exitPx : na, "Kena SL", style = shape.xcross, location = location.absolute, color = color.red, size = size.tiny)
plotshape(exShow and exitTxt == "TIME" ? exitPx : na, "Time stop", style = shape.square, location = location.absolute, color = color.orange, size = size.tiny)

// ----- Panel -----
var table tbl = table.new(position.top_right, 2, 15, bgcolor = color.new(color.black, 15), border_width = 1)
row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
pct(a, b) =>
    b > 0 ? str.tostring(a * 100.0 / b, "0.0") + "%" : "-"
stat(w, rr) =>
    e = nDone > 0 ? (w * rr - (nDone - w)) / nDone : 0.0
    nDone > 0 ? pct(w, nDone) + "  (" + (e >= 0 ? "+" : "") + str.tostring(e, "0.00") + "R)" : "-"

if showTbl and barstate.islast
    sts = tDir == 1 ? "BUY aktif" : tDir == -1 ? "SELL aktif" : "Tunggu signal"
    stCol = tDir == 1 ? color.lime : tDir == -1 ? color.red : color.white
    if tDir != 0
        row(12, ">> ENTRY", f(tEnt), color.aqua)
        row(13, ">> COLLECT", f(tTP1) + (not isHw ? " / " + f(tTP2) + " / " + f(tTP3) : ""), color.lime)
        row(14, ">> SL", f(tSL) + (tBeOn ? " (di entry)" : ""), color.red)
    else
        table.clear(tbl, 0, 12, 1, 14)
    if isHw
        nAll = nTP + nBE + nSL + nTM
        pf   = gLoss > 0 ? gWin / gLoss : na
        if tDir != 0
            sts := sts + " (candle " + str.tostring(bar_index - tBar) + "/" + str.tostring(hwMax) + ")"
        row(0, "XAU Signal", "Win Rate Tinggi", color.white)
        row(1, "Trend H4", hwUp ? "NAIK (cari BUY)" : hwSellOn ? "TURUN (cari SELL)" : "TURUN (rehat)", hwUp ? color.lime : color.red)
        row(2, "RSI(2)", str.tostring(rsi2, "0.0"), rsi2 < hwLvl or rsi2 > 100 - hwLvl ? color.yellow : color.white)
        row(3, "ADX / Struktur H1", str.tostring(adx, "0.0") + " / " + (hwStrUp ? "KUKUH" : hwStrDn ? "LEMAH" : "-"), adx < hwAdx and hwStrUp ? color.lime : color.gray)
        row(4, "Sesi", inSess ? "AKTIF" : "TUTUP", inSess ? color.lime : color.gray)
        row(5, "Status", sts, stCol)
        row(6, "Trade selesai", str.tostring(nAll), color.white)
        row(7, "Win (kena COLLECT)", pct(nTP, nAll), color.white)
        row(8, "Tidak rugi (TP + BE)", pct(nTP + nBE, nAll), color.white)
        row(9, "BE / SL / Time", pct(nBE, nAll) + " / " + pct(nSL, nAll) + " / " + pct(nTM, nAll), color.white)
        row(10, "Purata COLLECT / SL ($/oz)", (nTP > 0 ? "+" + str.tostring(sumTP / nTP, "0.00") : "-") + " / " + (nSL > 0 ? str.tostring(sumSL / nSL, "0.00") : "-"), color.white)
        row(11, timeframe.period == "60" ? "Profit factor" : "AMARAN", timeframe.period == "60" ? (na(pf) ? "-" : str.tostring(pf, "0.00")) : "Guna chart H1", timeframe.period == "60" ? (na(pf) or pf < 1 ? color.red : color.lime) : color.yellow)
    else
        row(0, "XAU Signal", "Trend TP3 | HTF " + htf + "m", color.white)
        row(1, "Trend HTF", htfClose > htfEma ? "NAIK" : "TURUN", htfClose > htfEma ? color.lime : color.red)
        row(2, "Trend chart", trendUp ? "NAIK" : trendDn ? "TURUN" : "TIADA", trendUp ? color.lime : trendDn ? color.red : color.gray)
        row(3, "ADX", str.tostring(adx, "0.0"), adxOk ? color.lime : color.gray)
        row(4, "RSI", str.tostring(rsi, "0.0"), color.white)
        row(5, "Sesi", inSess ? "AKTIF" : "TUTUP", inSess ? color.lime : color.gray)
        row(6, "Status", sts, stCol)
        row(7, "Trade selesai", str.tostring(nDone), color.white)
        row(8, "Win TP1 / TP2", stat(w1, tp1R) + "  |  " + stat(w2, tp2R), color.white)
        row(9, "Win TP3", stat(w3, tp3R), color.white)
