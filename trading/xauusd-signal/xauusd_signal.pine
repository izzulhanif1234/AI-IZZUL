//@version=6
// ============================================================================
//  XAUUSD Signal - Trend + Pullback + Confirmation
//  Chart disyorkan: XAUUSD M15 (trend dari H1). Boleh juga H1 (trend H4).
//  Signal hanya keluar bila candle TUTUP -> tiada repaint.
// ============================================================================
indicator("XAUUSD Signal - Trend Pullback", shorttitle = "XAU Signal", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ----- Input -----
gT = "Trend"
htf     = input.timeframe("60", "Timeframe trend (HTF)", group = gT)
htfLen  = input.int(200, "EMA trend HTF", minval = 1, group = gT)
fastLen = input.int(21, "EMA pantas", minval = 1, group = gT)
slowLen = input.int(50, "EMA perlahan", minval = 1, group = gT)
pbLen   = input.int(5, "Lookback pullback (bar)", minval = 1, group = gT)

gF = "Penapis"
useAdx  = input.bool(true, "Penapis ADX, minimum", inline = "adx", group = gF)
adxMin  = input.float(20, "", inline = "adx", group = gF)
useSess = input.bool(true, "Sesi London + New York sahaja", group = gF)
sess    = input.session("1400-0200", "Sesi (waktu Malaysia)", group = gF)

gR = "Risiko"
slBuf   = input.float(0.2, "Buffer SL (x ATR)", step = 0.1, group = gR)
minRisk = input.float(0.8, "SL minimum (x ATR)", step = 0.1, group = gR)
maxRisk = input.float(2.5, "SL maksimum (x ATR), lebih jauh = skip", step = 0.1, group = gR)
tp1R    = input.float(1.0, "TP1 (R)", step = 0.5, group = gR)
tp2R    = input.float(2.0, "TP2 (R)", step = 0.5, group = gR)
tp3R    = input.float(3.0, "TP3 (R)", step = 0.5, group = gR)

gD = "Paparan"
showEma  = input.bool(true, "Tunjuk EMA", group = gD)
showBg   = input.bool(false, "Warna latar ikut trend", group = gD)
showLvls = input.bool(true, "Tunjuk garisan Entry / SL / TP", group = gD)
showTbl  = input.bool(true, "Tunjuk panel", group = gD)

if timeframe.in_seconds(htf) < timeframe.in_seconds()
    runtime.error("Timeframe trend (HTF) mesti sama atau lebih besar dari timeframe chart.")

// ----- Indikator -----
emaF = ta.ema(close, fastLen)
emaS = ta.ema(close, slowLen)
rsi  = ta.rsi(close, 14)
atr  = ta.atr(14)
[diP, diM, adx] = ta.dmi(14, 14)

// Nilai HTF dari bar yang SUDAH tutup (tiada repaint)
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead = barmerge.lookahead_on)
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_on)

inSess = not useSess or not na(time(timeframe.period, sess, "Asia/Kuala_Lumpur"))
adxOk  = not useAdx or adx > adxMin
loN    = ta.lowest(low, pbLen)
hiN    = ta.highest(high, pbLen)

trendUp = htfClose > htfEma and emaF > emaS and close > emaS
trendDn = htfClose < htfEma and emaF < emaS and close < emaS

// Pullback ke EMA pantas + candle confirmation pecah high/low candle sebelum
buyRaw  = trendUp and loN <= emaF and close > open and close > high[1] and close > emaF and rsi > 50 and rsi < 70 and adxOk and inSess
sellRaw = trendDn and hiN >= emaF and close < open and close < low[1]  and close < emaF and rsi < 50 and rsi > 30 and adxOk and inSess

rawRiskBuy  = close - (loN - slBuf * atr)
rawRiskSell = (hiN + slBuf * atr) - close
riskBuy     = math.max(rawRiskBuy, minRisk * atr)
riskSell    = math.max(rawRiskSell, minRisk * atr)

// ----- Jejak trade (satu trade pada satu masa) -----
var int   tDir  = 0
var int   tBar  = na
var float tEnt  = na
var float tSL   = na
var float tTP1  = na
var float tTP2  = na
var float tTP3  = na
var bool  h1    = false
var bool  h2    = false
var bool  h3    = false
var int   nDone = 0
var int   w1    = 0
var int   w2    = 0
var int   w3    = 0

closedNow = false
if tDir != 0 and bar_index > tBar
    slHit = tDir == 1 ? low <= tSL : high >= tSL
    if not slHit      // SL & TP dalam candle sama -> dikira SL (konservatif)
        h1 := h1 or (tDir == 1 ? high >= tTP1 : low <= tTP1)
        h2 := h2 or (tDir == 1 ? high >= tTP2 : low <= tTP2)
        h3 := h3 or (tDir == 1 ? high >= tTP3 : low <= tTP3)
    if slHit or h3
        nDone += 1
        w1 += h1 ? 1 : 0
        w2 += h2 ? 1 : 0
        w3 += h3 ? 1 : 0
        tDir := 0
        closedNow := true

buySig  = barstate.isconfirmed and tDir == 0 and not closedNow and buyRaw  and rawRiskBuy  <= maxRisk * atr
sellSig = barstate.isconfirmed and tDir == 0 and not closedNow and sellRaw and rawRiskSell <= maxRisk * atr

f(x) => str.tostring(x, format.mintick)

if buySig or sellSig
    tDir := buySig ? 1 : -1
    risk  = buySig ? riskBuy : riskSell
    tBar := bar_index
    tEnt := close
    tSL  := close - tDir * risk
    tTP1 := close + tDir * tp1R * risk
    tTP2 := close + tDir * tp2R * risk
    tTP3 := close + tDir * tp3R * risk
    h1 := false
    h2 := false
    h3 := false

    side = buySig ? "BUY" : "SELL"
    txt  = side + "\nEntry " + f(tEnt) + "\nSL " + f(tSL) + "\nTP1 " + f(tTP1) + "\nTP2 " + f(tTP2) + "\nTP3 " + f(tTP3)
    label.new(bar_index, buySig ? low - 0.3 * atr : high + 0.3 * atr, txt,
              style = buySig ? label.style_label_up : label.style_label_down,
              color = buySig ? color.new(color.green, 0) : color.new(color.red, 0),
              textcolor = color.white, size = size.small)
    if showLvls
        line.new(bar_index, tEnt, bar_index + 15, tEnt, color = color.gray)
        line.new(bar_index, tSL,  bar_index + 15, tSL,  color = color.red)
        line.new(bar_index, tTP1, bar_index + 15, tTP1, color = color.new(color.green, 50), style = line.style_dashed)
        line.new(bar_index, tTP2, bar_index + 15, tTP2, color = color.new(color.green, 25), style = line.style_dashed)
        line.new(bar_index, tTP3, bar_index + 15, tTP3, color = color.green)

    msg = '{"signal":"' + side + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period +
          '","entry":' + f(tEnt) + ',"sl":' + f(tSL) + ',"tp1":' + f(tTP1) + ',"tp2":' + f(tTP2) + ',"tp3":' + f(tTP3) + '}'
    alert(msg, alert.freq_once_per_bar_close)

alertcondition(buySig,  "XAU BUY",  "XAUUSD BUY signal - semak chart untuk Entry/SL/TP")
alertcondition(sellSig, "XAU SELL", "XAUUSD SELL signal - semak chart untuk Entry/SL/TP")

// ----- Plot -----
plot(showEma ? emaF : na, "EMA pantas", color = color.aqua)
plot(showEma ? emaS : na, "EMA perlahan", color = color.orange)
plot(showEma ? htfEma : na, "EMA HTF", color = color.gray, linewidth = 2, style = plot.style_stepline)
bgcolor(showBg and trendUp ? color.new(color.green, 92) : showBg and trendDn ? color.new(color.red, 92) : na)

// ----- Panel -----
var table tbl = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 15), border_width = 1)
row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
stat(w, rr) =>
    e = nDone > 0 ? (w * rr - (nDone - w)) / nDone : 0.0
    nDone > 0 ? str.tostring(w * 100.0 / nDone, "0.0") + "%  (" + (e >= 0 ? "+" : "") + str.tostring(e, "0.00") + "R)" : "-"

if showTbl and barstate.islast
    row(0, "XAUUSD Signal", timeframe.period + " / HTF " + htf, color.white)
    row(1, "Trend HTF", htfClose > htfEma ? "NAIK" : "TURUN", htfClose > htfEma ? color.lime : color.red)
    row(2, "Trend chart", trendUp ? "NAIK" : trendDn ? "TURUN" : "TIADA", trendUp ? color.lime : trendDn ? color.red : color.gray)
    row(3, "ADX", str.tostring(adx, "#.0"), adxOk ? color.lime : color.gray)
    row(4, "RSI", str.tostring(rsi, "#.0"), color.white)
    row(5, "Sesi", inSess ? "AKTIF" : "TUTUP", inSess ? color.lime : color.gray)
    row(6, "Status", tDir == 1 ? "BUY aktif" : tDir == -1 ? "SELL aktif" : "Tunggu signal", tDir == 1 ? color.lime : tDir == -1 ? color.red : color.white)
    row(7, "Trade selesai", str.tostring(nDone), color.white)
    row(8, "Win TP1 / TP2", stat(w1, tp1R) + "  |  " + stat(w2, tp2R), color.white)
    row(9, "Win TP3", stat(w3, tp3R), color.white)
