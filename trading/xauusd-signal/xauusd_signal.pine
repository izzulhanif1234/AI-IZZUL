//@version=6
// ============================================================================
//  XAUUSD Signal - LIMIT entry + tempat wajib close
//  Guna pada chart M15 atau H1.
//
//  BUY : trend H4 naik, harga atas EMA50 & EMA200, harga baru jatuh mendadak
//  SELL: trend H4 turun, harga bawah EMA50 & EMA200, harga baru naik mendadak
//
//  Bila signal keluar, pasang order LIMIT (tak masuk terus):
//    BUY LIMIT  = harga signal - 0.25 ATR   (SELL LIMIT = + 0.25 ATR)
//    COLLECT    = harga signal + 0.5 ATR    (wajib close untung)
//    SL         = harga signal - 3 ATR      (wajib close rugi)
//  Order batal kalau tak kena dalam 6 candle, atau harga terus ke COLLECT.
//
//  Signal keluar bila candle TUTUP dan tidak berubah selepas itu (tiada repaint).
// ============================================================================
indicator("XAUUSD Signal", shorttitle = "XAU Signal", overlay = true, max_labels_count = 100, max_lines_count = 100)

htf      = input.timeframe("240", "Timeframe trend")
rsiLvl   = input.int(30, "RSI(2): BUY bawah nilai ni, SELL atas 100 - nilai", minval = 1, maxval = 49)
adxMax   = input.float(30, "ADX maksimum")
limAtr   = input.float(0.25, "Jarak LIMIT dari harga signal (x ATR), 0 = masuk terus", step = 0.05)
limBars  = input.int(6, "Order LIMIT sah untuk N candle", minval = 1)
tpAtr    = input.float(0.5, "COLLECT dari harga signal (x ATR)", step = 0.1)
slAtr    = input.float(3.0, "SL dari harga signal (x ATR)", step = 0.1)
pipVal   = input.float(0.10, "1 pip = berapa $ (ikut broker anda)", options = [0.10, 1.0])
useSess  = input.bool(true, "Sesi London + New York sahaja")
sess     = input.session("1400-0200", "Sesi (waktu Malaysia)")
allowBuy = input.bool(true, "Signal BUY")
allowSel = input.bool(true, "Signal SELL")
showPrep = input.bool(true, "Tunjuk BERSEDIA pada candle yang belum tutup")
showTbl  = input.bool(true, "Tunjuk panel monitor")

if timeframe.in_seconds(htf) <= timeframe.in_seconds()
    runtime.error("Timeframe trend mesti lebih besar dari timeframe chart. Guna chart M15 atau H1.")

// ----- Kiraan -----
rsi2 = ta.rsi(close, 2)
atr  = ta.atr(14)
e50  = ta.ema(close, 50)
e200 = ta.ema(close, 200)
[diP, diM, adx] = ta.dmi(14, 14)

// Trend H4 dari candle H4 yang SUDAH tutup (tiada repaint)
hClose = request.security(syminfo.tickerid, htf, close[1], lookahead = barmerge.lookahead_on)
hEma   = request.security(syminfo.tickerid, htf, ta.ema(close, 200)[1], lookahead = barmerge.lookahead_on)

inSess = not useSess or not na(time(timeframe.period, sess, "Asia/Kuala_Lumpur"))

okBuy  = allowBuy and hClose > hEma and close > e50 and close > e200 and rsi2 < rsiLvl and adx < adxMax and inSess
okSell = allowSel and hClose < hEma and close < e50 and close < e200 and rsi2 > 100 - rsiLvl and adx < adxMax and inSess

// ----- Trade semasa -----
// tState: 0 = tiada, 1 = order LIMIT menunggu, 2 = position aktif
var int   tState = 0
var int   tDir   = 0
var int   tBar   = na
var int   tFill  = na
var float tEnt   = na
var float tTP    = na
var float tSL    = na
var int   nTP    = 0
var int   nSL    = 0
var int   nMiss  = 0

f(x) => str.tostring(x, format.mintick)
pips(d) => str.tostring(math.abs(d), "0.00") + "$ / " + str.tostring(math.abs(d) / pipVal, "0") + " pip"

filled = false
missed = false
hitTP  = false
hitSL  = false
if tState == 1 and bar_index > tBar
    if tDir == 1 ? low <= tEnt : high >= tEnt
        filled := true
        tState := 2
        tFill  := bar_index
    else if tDir == 1 ? high >= tTP : low <= tTP
        missed := true
    else if bar_index - tBar >= limBars
        missed := true
    if missed
        nMiss  += 1
        tState := 0
if tState == 2
    // SL disemak dulu (konservatif). COLLECT hanya dikira selepas candle fill.
    hitSL := tDir == 1 ? low <= tSL : high >= tSL
    hitTP := not hitSL and bar_index > tFill and (tDir == 1 ? high >= tTP : low <= tTP)
    if hitSL or hitTP
        nTP    += hitTP ? 1 : 0
        nSL    += hitSL ? 1 : 0
        tState := 0
doneNow = missed or hitSL or hitTP

sideTxt = tDir == 1 ? "BUY" : "SELL"
if filled
    alert("XAUUSD " + sideTxt + " LIMIT kena di " + f(tEnt) + " - position aktif. COLLECT " + f(tTP) + " | SL " + f(tSL), alert.freq_once_per_bar)
if missed
    alert("XAUUSD BATALKAN order " + sideTxt + " LIMIT " + f(tEnt) + " - tak kena", alert.freq_once_per_bar_close)
if hitTP
    alert("XAUUSD sampai COLLECT " + f(tTP) + " - CLOSE SEKARANG (untung)", alert.freq_once_per_bar)
if hitSL
    alert("XAUUSD kena SL " + f(tSL) + " - CLOSE SEKARANG", alert.freq_once_per_bar)

// ----- Signal baru -----
buySig  = barstate.isconfirmed and tState == 0 and not doneNow and okBuy
sellSig = barstate.isconfirmed and tState == 0 and not doneNow and okSell and not buySig

var array<line>  lns  = array.new<line>()
var array<label> lbls = array.new<label>()

lvl(y, nm, col) =>
    array.push(lns, line.new(bar_index, y, bar_index + 20, y, color = col, width = 2))
    array.push(lbls, label.new(bar_index + 20, y, nm + "  " + f(y), style = label.style_label_left, color = col, textcolor = color.white, size = size.small))

if buySig or sellSig
    // padam lukisan trade sebelum supaya chart tak penuh
    for ln in lns
        line.delete(ln)
    for lb in lbls
        label.delete(lb)
    array.clear(lns)
    array.clear(lbls)

    tDir   := buySig ? 1 : -1
    tState := 1
    tBar   := bar_index
    tEnt   := close - tDir * limAtr * atr
    tTP    := close + tDir * tpAtr * atr
    tSL    := close - tDir * slAtr * atr
    side   = buySig ? "BUY" : "SELL"
    ordTxt = limAtr > 0 ? side + " LIMIT" : side

    lvl(tEnt, "ENTRY " + ordTxt, color.blue)
    lvl(tTP, "COLLECT", color.green)
    lvl(tSL, "SL", color.red)

    txt    = ordTxt + "\nENTRY    " + f(tEnt) + "\nCOLLECT  " + f(tTP) + "  (+" + pips(tTP - tEnt) + ")\nSL       " + f(tSL) + "  (-" + pips(tEnt - tSL) + ")\nBatal lepas " + str.tostring(limBars) + " candle"
    lblY   = buySig ? low - 0.3 * atr : high + 0.3 * atr
    lblSty = buySig ? label.style_label_up : label.style_label_down
    lblCol = buySig ? color.green : color.red
    array.push(lbls, label.new(bar_index, lblY, txt, style = lblSty, color = lblCol, textcolor = color.white, size = size.small))
    alert("XAUUSD pasang " + ordTxt + " " + f(tEnt) + " | COLLECT " + f(tTP) + " | SL " + f(tSL) + " | batal lepas " + str.tostring(limBars) + " candle", alert.freq_once_per_bar_close)

// ----- BERSEDIA: setup sedang terbentuk, candle belum tutup (belum signal) -----
prepBuy  = showPrep and not barstate.isconfirmed and tState == 0 and okBuy
prepSell = showPrep and not barstate.isconfirmed and tState == 0 and okSell and not prepBuy
if prepBuy or prepSell
    alert("XAUUSD BERSEDIA " + (prepBuy ? "BUY" : "SELL") + " - signal sah bila candle tutup", alert.freq_once_per_bar)

// ----- Tanda di chart -----
plotshape(buySig, "BUY", style = shape.triangleup, location = location.belowbar, color = color.green, size = size.small)
plotshape(sellSig, "SELL", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small)
plotshape(prepBuy, "BERSEDIA BUY", style = shape.diamond, location = location.belowbar, color = color.yellow, text = "BERSEDIA", textcolor = color.yellow, size = size.tiny)
plotshape(prepSell, "BERSEDIA SELL", style = shape.diamond, location = location.abovebar, color = color.yellow, text = "BERSEDIA", textcolor = color.yellow, size = size.tiny)

alertcondition(buySig, "XAU BUY LIMIT", "XAUUSD pasang BUY LIMIT - semak chart untuk ENTRY / COLLECT / SL")
alertcondition(sellSig, "XAU SELL LIMIT", "XAUUSD pasang SELL LIMIT - semak chart untuk ENTRY / COLLECT / SL")
alertcondition(filled, "XAU order kena", "XAUUSD order LIMIT kena - position aktif")
alertcondition(missed, "XAU batal order", "XAUUSD BATALKAN order LIMIT - tak kena")
alertcondition(hitTP, "XAU sampai COLLECT", "XAUUSD sampai COLLECT - CLOSE SEKARANG (untung)")
alertcondition(hitSL, "XAU kena SL", "XAUUSD kena SL - CLOSE SEKARANG")
alertcondition(prepBuy or prepSell, "XAU bersedia", "XAUUSD setup sedang terbentuk - signal sah bila candle tutup")

// ----- Panel monitor -----
var table tbl = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, 15), border_width = 1)
row(r, k, v, c) =>
    table.cell(tbl, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

if showTbl and barstate.islast
    tfOk = timeframe.period == "15" or timeframe.period == "60"
    hUp  = hClose > hEma
    sUp  = close > e50 and close > e200
    sDn  = close < e50 and close < e200
    sts  = "Tiada setup - trend bercampur"
    stC  = color.gray
    if tState == 2
        sts := sideTxt + " aktif - tunggu COLLECT / SL"
        stC := tDir == 1 ? color.lime : color.red
    else if tState == 1
        sts := sideTxt + " LIMIT menunggu (candle " + str.tostring(bar_index - tBar) + "/" + str.tostring(limBars) + ")"
        stC := color.aqua
    else if prepBuy or prepSell
        sts := "BERSEDIA " + (prepBuy ? "BUY" : "SELL") + " - tunggu candle tutup"
        stC := color.yellow
    else if hUp and sUp and allowBuy
        sts := "Tunggu dip untuk BUY"
        stC := color.white
    else if not hUp and sDn and allowSel
        sts := "Tunggu lonjakan untuk SELL"
        stC := color.white
    if tState == 0 and not inSess
        sts := sts + " (sesi tutup)"

    row(0, "XAU Signal", tfOk ? (timeframe.period == "15" ? "M15" : "H1") : "Guna chart M15 / H1", tfOk ? color.white : color.yellow)
    row(1, "Trend H4", hUp ? "NAIK" : "TURUN", hUp ? color.lime : color.red)
    row(2, "Struktur EMA50 / EMA200", sUp ? "ATAS (sokong BUY)" : sDn ? "BAWAH (sokong SELL)" : "CAMPUR", sUp ? color.lime : sDn ? color.red : color.gray)
    row(3, "RSI(2)", str.tostring(rsi2, "0.0") + (rsi2 < rsiLvl ? "  DIP" : rsi2 > 100 - rsiLvl ? "  LONJAK" : ""), rsi2 < rsiLvl or rsi2 > 100 - rsiLvl ? color.yellow : color.white)
    row(4, "ADX", str.tostring(adx, "0.0") + (adx < adxMax ? "  OK" : "  terlalu laju"), adx < adxMax ? color.lime : color.gray)
    row(5, "Sesi London + NY", inSess ? "AKTIF" : "TUTUP", inSess ? color.lime : color.gray)
    row(6, "Status", sts, stC)
    if tState != 0
        row(7, ">> ENTRY" + (tState == 1 ? " (LIMIT)" : ""), f(tEnt), color.aqua)
        row(8, ">> COLLECT", f(tTP) + "  (+" + pips(tTP - tEnt) + ")", color.lime)
        row(9, ">> SL", f(tSL) + "  (-" + pips(tEnt - tSL) + ")", color.red)
        if tState == 2
            pnl  = (close - tEnt) * tDir
            toSL = pnl < 0 ? -pnl / math.abs(tEnt - tSL) * 100 : 0.0
            pTxt = (pnl >= 0 ? "+" : "") + str.tostring(pnl, "0.00") + (pnl >= 0 ? " (menuju COLLECT)" : " (" + str.tostring(toSL, "0") + "% jalan ke SL)")
            row(10, ">> Sekarang", pTxt, pnl >= 0 ? color.lime : toSL < 30 ? color.orange : color.red)
        else
            table.clear(tbl, 0, 10, 1, 10)
    else
        table.clear(tbl, 0, 7, 1, 10)
    nAll = nTP + nSL
    row(11, "Rekod chart ni", nAll > 0 ? str.tostring(nTP * 100.0 / nAll, "0.0") + "% kena COLLECT (" + str.tostring(nAll) + " trade, " + str.tostring(nMiss) + " batal)" : "-", color.white)
